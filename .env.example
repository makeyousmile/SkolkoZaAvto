# ==============================================================================
# Шаблон переменных окружения для SkolkoZaAvto
# Скопируйте этот файл в '.env' и настройте значения перед запуском приложения.
# ==============================================================================

# Режим работы приложения (production / development)
APP_ENV=development

# Пароль администратора (ОБЯЗАТЕЛЬНО измените в продакшене!)
ADMIN_PASSWORD=chaka

# Временная зона и внутренний порт приложения
TZ=Europe/Minsk
PORT=8080

# Режим SSL для Reproxy
# 'none' — для локальной разработки (без SSL / HTTPS)
# 'auto' — для продакшена (автоматический выпуск Let's Encrypt сертификатов)
SSL_TYPE=none

# Email и доменное имя для выпуска SSL (нужны только если SSL_TYPE=auto)
# SSL_ACME_EMAIL=your-email@example.com
# SSL_ACME_FQDN=yourdomain.by
